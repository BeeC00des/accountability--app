PORT=5000
MONGODB_URI=mongodb://localhost:27017/accountability
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
CLIENT_URL=http://localhost:3000


# Premium (Community) requests are emailed here
ADMIN_EMAIL=you@example.com
# Public address of this API, used in the one-click approve link (defaults to http://localhost:PORT)
API_PUBLIC_URL=

# Bachs payments: API key (sk_sandbox_… or sk_live_…) and webhook signing secret
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
COMMUNITY_PRICE_NGN=22000
# Optional: public site address for payment returns when CLIENT_URL is local
PUBLIC_SITE_URL=
